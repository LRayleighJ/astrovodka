# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Build / packaging ----
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- Test / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- Environment managers ----
.venv/
venv/
env/
.conda/

# ---- Example and tutorial outputs ----
# Everything the examples write lands in examples/outputs/ and is not tracked.
examples/outputs/
*.fits
*.hdf5
*.h5

# ---- Jupyter ----
.ipynb_checkpoints/
*.nbconvert.ipynb

# ---- Editors ----
.vscode/
.idea/
*.swp
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Cluster filesystems ----
# NFS "silly rename" files: a deleted file still held open by a running
# process reappears under this name on NFS mounts.
.nfs*
